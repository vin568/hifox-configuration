#!/bin/sh
# 用途：主控管理本实例常驻 serve 的唯一白名单入口（ADR 0019 第 2 级 + ADR 0036）。
# 参数：status | start | stop | restart（唯一一个动词；额外参数一律拒绝）。
# 示例：super-agent/direct/server status
#       super-agent/direct/server restart
# 副作用：start/stop/restart 真实改变本机常驻 serve（审计落 state/serve-audit.jsonl，
#         actor=master）；status 只读。永不 build、不改配置/凭证、不碰主控会话。
#         入口过期时框架会拒绝并提示执行 super-agent/build。
set -eu

if [ $# -ne 1 ]; then
  echo "server: 只接受一个动词参数（status|start|stop|restart）；收到 $# 个" >&2
  exit 2
fi
verb=$1

case "$verb" in
  status|start|stop|restart) ;;
  *)
    echo "server: 只允许 status|start|stop|restart（收到 ${verb}）；构建/改配置不在本入口范围" >&2
    exit 2
    ;;
esac

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

bin="$root/bin/superctl"
if [ ! -x "$bin" ]; then
  echo "server: 稳定入口不存在或不可执行：${bin}（请执行 super-agent/build）" >&2
  exit 2
fi

# 固定本实例配置：不读取调用者的 SUPERAGENT_CONFIG——换配置就等于换实例，
# 白名单入口只服务本实例（ADR 0036「固定 SUPERAGENT_CONFIG 与绝对路径」）。
cfg="${HOME:?HOME 未设置}/.config/super-agent/superctl.toml"
export SUPERAGENT_CONFIG="$cfg"

exec "$bin" server "$verb" --config "$cfg" --actor master
